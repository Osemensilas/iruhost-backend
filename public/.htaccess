<IfModule mod_rewrite.c>
RewriteEngine On

# Allow preflight (OPTIONS) requests to reach PHP
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ index.php [QSA,L]

# Send all other non-file requests to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
</IfModule>

# --- CORS Fix for LiteSpeed ---
<IfModule mod_headers.c>
    # Remove any wildcard or default CORS headers injected by LiteSpeed or Apache
    Header always unset Access-Control-Allow-Origin
    Header always unset Access-Control-Allow-Methods
    Header always unset Access-Control-Allow-Headers
    Header always unset Access-Control-Allow-Credentials
</IfModule>
